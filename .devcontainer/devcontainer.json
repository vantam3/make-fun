{
  "name": "make-fun bounty workspace",
  "image": "mcr.microsoft.com/devcontainers/base:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": [
    "npm",
    "install",
    "--global",
    "@openai/codex"
  ]
}
